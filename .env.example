# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env` file - it is already excluded via .gitignore.

# Azure OpenAI (used for the function-calling / agent notebooks)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4o

# Optional: pin a specific subscription/tenant instead of relying on
# `az account set` / the Azure CLI default profile.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Azure API Management AI gateway / MCP server (used by notebooks 16-22)
# See docs/10_apim_ai_gateway_and_mcp.md for how to create these.
APIM_MCP_SERVER_URL=https://<your-apim-name>.azure-api.net/<mcp-server-path>/mcp
APIM_SUBSCRIPTION_KEY=
APIM_MCP_SCOPE=api://<your-entra-app-id>/.default
APIM_GATEWAY_ENDPOINT=https://<your-apim-name>.azure-api.net/<openai-api-path>
